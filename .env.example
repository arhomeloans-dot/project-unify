# Copy to .env (git-ignored) or set as User-scope environment variables.
#
# HuggingFace token for Tier 3 (Inference Providers router).
# Create at: https://huggingface.co/settings/tokens  (read access is enough)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Windows, persistent (survives reboot — required for auto-start):
#   [Environment]::SetEnvironmentVariable("HF_TOKEN","hf_xxx","User")
